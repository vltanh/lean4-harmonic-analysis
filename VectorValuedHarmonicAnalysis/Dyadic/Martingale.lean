module

public import BanachProbability.UMD.Decoupling
public import Mathlib.MeasureTheory.Function.Floor
public import Mathlib.MeasureTheory.Measure.Lebesgue.EqHaar

/-!
# Dyadic averages and Haar projections on the line

The dyadic intervals of generation `j ≥ 0` are `2^{−j} [m, m + 1)`, `m ∈ ℤ`. For a locally
integrable `f : ℝ → X`, `dyadicAvg j f (x)` is the average of `f` over the interval of generation
`j` that contains `x`; on each unit interval `[m, m + 1)`, a probability space, the dyadic averages
form a martingale (`martingale_dyadicAvg`). With `h = 1_{[0, 1/2)} − 1_{[1/2, 1)}` (`haar`) and a
function `k` supported in `[0, 1)`,

`dyadicShift k j f = Σ_{I of generation j} k_I ⟨h_I, f⟩`,
`k_I (x) = |I|^{−1/2} k ((x − inf I) / |I|)`,

is the part of generation `j` of the dyadic shift with kernel `k`; for `k = h` it is the Haar
projection `dyadicAvg (j + 1) f − dyadicAvg j f` (`dyadicShift_haar`).

Source: Hytönen–van Neerven–Veraar–Weis (HNVW), *Analysis in Banach spaces I* (2016), Section 5.1.a,
pp. 375–377. Only the generations `j ≥ 0` are needed here; the others are reached by dilation.
-/

@[expose] public section

open MeasureTheory
open scoped ENNReal

namespace VectorValuedHarmonicAnalysis

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- The dyadic interval `2^{−j} [m, m + 1)` of generation `j` that contains `x`, `m = ⌊2^j x⌋`. -/
noncomputable def dyadicInterval (j : ℕ) (x : ℝ) : Set ℝ :=
  Set.Ico ((⌊2 ^ j * x⌋ : ℝ) / 2 ^ j) (((⌊2 ^ j * x⌋ : ℝ) + 1) / 2 ^ j)

/-- The average of `f` over the dyadic interval of generation `j` that contains `x`. -/
noncomputable def dyadicAvg (j : ℕ) (f : ℝ → X) (x : ℝ) : X :=
  (2 : ℝ) ^ j • ∫ y in dyadicInterval j x, f y

/-- The filtration of the dyadic intervals: the `j`-th σ-algebra is generated by `x ↦ ⌊2^j x⌋`. -/
noncomputable def dyadicFiltration : Filtration ℕ Real.measurableSpace where
  seq j := MeasurableSpace.comap (fun x : ℝ => ⌊2 ^ j * x⌋) ⊤
  mono' := by
    sorry
  le' := by
    sorry

/-- On each unit interval, the dyadic averages form a martingale. -/
theorem martingale_dyadicAvg [CompleteSpace X] {f : ℝ → X} (hf : LocallyIntegrable f) (m : ℤ) :
    Martingale (fun j => dyadicAvg j f) dyadicFiltration
      (volume.restrict (Set.Ico (m : ℝ) (m + 1))) := by
  sorry

/-- The Haar function `h = 1_{[0, 1/2)} − 1_{[1/2, 1)}`. -/
noncomputable def haar (x : ℝ) : ℝ :=
  (Set.Ico (0 : ℝ) (1 / 2)).indicator 1 x - (Set.Ico (1 / 2 : ℝ) 1).indicator 1 x

/-- HNVW I, (5.19): `k = h (2 ·) − h (2 · − 1) = 1_{[0, 1/4) ∪ [3/4, 1)} − 1_{[1/4, 3/4)}`. -/
noncomputable def haarSplit (x : ℝ) : ℝ := haar (2 * x) - haar (2 * x - 1)

/-- The part of generation `j` of the dyadic shift with kernel `k`:
`Σ_{I of generation j} k_I ⟨h_I, f⟩`. -/
noncomputable def dyadicShift (k : ℝ → ℝ) (j : ℕ) (f : ℝ → X) (x : ℝ) : X :=
  (2 ^ j * k (Int.fract (2 ^ j * x))) • ∫ y, haar (2 ^ j * y - ⌊2 ^ j * x⌋) • f y

theorem dyadicShift_haar {f : ℝ → X} (hf : LocallyIntegrable f) (j : ℕ) :
    dyadicShift haar j f = fun x => dyadicAvg (j + 1) f x - dyadicAvg j f x := by
  sorry

end VectorValuedHarmonicAnalysis
